# Copy to /etc/caddy/caddy.env and fill in the token.
# touch /etc/caddy/caddy.env && chown root:root /etc/caddy/caddy.env && chmod 600 /etc/caddy/caddy.env
# Cloudflare token permissions, limited to the zone of your vault hostname:
#   Zone > Zone > Read
#   Zone > DNS > Edit
CLOUDFLARE_API_TOKEN=YOUR_TOKEN

# DuckDNS instead of Cloudflare (use `dns duckdns {env.DUCKDNS_API_TOKEN}` in the Caddyfile):
# DUCKDNS_API_TOKEN=YOUR_TOKEN
